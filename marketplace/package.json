{
  "name": "@chipwright/marketplace",
  "version": "0.0.0",
  "private": true,
  "description": "Package registry for OpenHome device definitions: signed packages of DDL, drivers, tests, and metadata, with publish, search, and install",
  "license": "Elastic-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openhome": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/serve.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chipwright/conformance": "workspace:*",
    "@chipwright/device-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
