{
  "name": "chipwright",
  "displayName": "Chipwright",
  "version": "0.1.0",
  "description": "Define a smart device once and generate its firmware interface, cloud API, tests, docs, and Matter device. Visual designer, live twin debugger, and AI assistant.",
  "license": "Elastic-2.0",
  "publisher": "chipwright",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Diegoregalado0/openhome-studio.git",
    "directory": "apps/ide"
  },
  "homepage": "https://github.com/Diegoregalado0/openhome-studio#readme",
  "bugs": {
    "url": "https://github.com/Diegoregalado0/openhome-studio/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:openhome.devices",
    "onCommand:openhome.newDevice",
    "onCommand:openhome.openManifest",
    "onCommand:openhome.openDesigner",
    "onCommand:openhome.debugTwin",
    "onCommand:openhome.openAssistant"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openhome",
          "title": "Chipwright",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "openhome": [
        {
          "id": "openhome.devices",
          "name": ""
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openhome.devices",
        "contents": "No devices found here.\n\nCreate one from a template, or start from scratch.\n[Create device](command:openhome.newDevice)\n\nAlready have a manifest? Pick the file directly.\n[Open a device manifest](command:openhome.openManifest)"
      }
    ],
    "commands": [
      {
        "command": "openhome.newDevice",
        "title": "New Device",
        "category": "Chipwright",
        "icon": "$(add)"
      },
      {
        "command": "openhome.openManifest",
        "title": "Open Device Manifest...",
        "category": "Chipwright",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openhome.openDesigner",
        "title": "Open Device Designer",
        "category": "Chipwright"
      },
      {
        "command": "openhome.debugTwin",
        "title": "Debug Twin",
        "category": "Chipwright"
      },
      {
        "command": "openhome.openAssistant",
        "title": "Open Assistant",
        "category": "Chipwright",
        "icon": "$(sparkle)"
      },
      {
        "command": "openhome.refreshDevices",
        "title": "Refresh Devices",
        "category": "Chipwright",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openhome.newDevice",
          "when": "view == openhome.devices",
          "group": "navigation@1"
        },
        {
          "command": "openhome.openAssistant",
          "when": "view == openhome.devices",
          "group": "navigation@2"
        },
        {
          "command": "openhome.refreshDevices",
          "when": "view == openhome.devices",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "openhome.openAssistant",
          "when": "view == openhome.devices",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Chipwright",
      "properties": {
        "openhome.assistant.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "gemini",
            "openai-compatible"
          ],
          "default": "anthropic",
          "description": "LLM provider for the AI assistant. openai-compatible works with OpenAI, OpenRouter, and local servers via a base URL."
        },
        "openhome.assistant.model": {
          "type": "string",
          "default": "",
          "description": "Model id to use. Leave blank to use the provider's default."
        },
        "openhome.assistant.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for the openai-compatible provider, e.g. http://localhost:11434/v1 for Ollama. The API key is set separately and stored securely."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@openhome/assistant": "workspace:*",
    "@openhome/studio-core": "workspace:*",
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
