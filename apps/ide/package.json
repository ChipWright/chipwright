{
  "name": "@openhome/ide",
  "displayName": "OpenHome Studio",
  "version": "0.0.0",
  "private": true,
  "description": "Developer IDE for OpenHome Studio: visual device designer and live twin debugger, delivered as a VS Code extension over the shell-agnostic studio core",
  "license": "MIT",
  "publisher": "openhome",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:openhome.devices",
    "onCommand:openhome.newDevice",
    "onCommand:openhome.openDesigner",
    "onCommand:openhome.debugTwin"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openhome",
          "title": "OpenHome Studio",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "openhome": [
        {
          "id": "openhome.devices",
          "name": "Devices"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openhome.devices",
        "contents": "No devices yet.\n\nCreate one from a template, or start from scratch.\n[Create device](command:openhome.newDevice)\n\nAlready have device.yaml files? Open the folder that contains them, then refresh.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "commands": [
      {
        "command": "openhome.newDevice",
        "title": "New Device",
        "category": "OpenHome",
        "icon": "$(add)"
      },
      {
        "command": "openhome.openDesigner",
        "title": "Open Device Designer",
        "category": "OpenHome"
      },
      {
        "command": "openhome.debugTwin",
        "title": "Debug Twin",
        "category": "OpenHome"
      },
      {
        "command": "openhome.refreshDevices",
        "title": "Refresh Devices",
        "category": "OpenHome",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openhome.newDevice",
          "when": "view == openhome.devices",
          "group": "navigation@1"
        },
        {
          "command": "openhome.refreshDevices",
          "when": "view == openhome.devices",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openhome/studio-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
